TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/i686-pc-windows-gnu/release
STATLIB = $(LIBDIR)/librwarp_r.a
PKG_LIBS = -L$(LIBDIR) -lrwarp_r -lws2_32 -ladvapi32 -luserenv -lbcrypt

all: C_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --lib --release --manifest-path=./rust/Cargo.toml \
		--target i686-pc-windows-gnu --target-dir $(TARGET_DIR)

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
